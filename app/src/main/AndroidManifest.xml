<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11+): needed to reopen a remembered post inside X. -->
    <queries>
        <package android:name="com.twitter.android" />
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:name=".XAdApplication"
        android:supportsRtl="true"
        android:theme="@style/Theme.XADBlock">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.HookBridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.xadblock.module.ACTION_BLOCK_EVENTS" />
                <action android:name="com.xadblock.module.ACTION_HEARTBEAT" />
                <action android:name="com.xadblock.module.ACTION_HOOK_LOGS" />
                <action android:name="com.xadblock.module.ACTION_VIEW_EVENTS" />
            </intent-filter>
        </receiver>

        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
